{
  "name": "@vahapogut/antigravity-model-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Optional routing gateway and dashboard for antigravity-add-model",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "antigravity-gateway": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
