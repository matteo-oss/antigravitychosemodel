    "setup": "node dist/cli.js setup",
    "test": "node --import tsx test/run-gateway.ts"
  },
  "dependencies": {
    "chart.js": "4.4.7",
    "dotenv": "^17.4.2",
    "undici": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
